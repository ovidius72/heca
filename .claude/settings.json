{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/preflight.sh\"",
            "timeout": 10,
            "statusMessage": "AGENTS.md \u00a7 0 pre-flight"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cargo-scope.sh\"",
            "timeout": 10,
            "statusMessage": "AGENTS.md cargo scope"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/antonio/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/antonio/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}