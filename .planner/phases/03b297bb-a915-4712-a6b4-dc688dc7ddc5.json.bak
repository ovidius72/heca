    {
      "id": "750b8ef0-b707-4693-a58d-21511d60f882",
      "phaseId": "03b297bb-a915-4712-a6b4-dc688dc7ddc5",
      "number": 222,
      "shortId": "U6QAH",
      "priority": 2,
      "shortName": "system-mode-v1",
      "title": "Implement temporary system-mode in-app fallback",
      "status": "planned",
      "description": "Finché P063 non fornisce un backend OS, `NotificationSystem::System` consegna ogni draft allo store in-app e scrive un solo warning per sessione indicante che il backend nativo non è disponibile. Conservare il flag nel NotificationRuntime; non emettere il warning come una notifica che rientra ricorsivamente nel router. Reload system→app→system nella stessa sessione non ripete il warning. Documentare che questo è comportamento temporaneo ma deterministico.",
      "notes": "",
