        {
          "id": "5ef43ba4-d6c8-482f-a908-40b1426a19e3-check-004-right-click-trigger-target-widget-under-the-pointer-bubbling-to-the-nearest-declaring-ancestor",
          "number": 4,
          "title": "right_click trigger: target = widget under the pointer, bubbling to the nearest declaring ancestor",
          "checked": true
