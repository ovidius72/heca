    {
      "id": "d9365597-d60e-4ff4-b3dd-b3ffcf970789",
      "phaseId": "7a3c634c-5aba-4de1-a01a-5c07f4ee4cb4",
      "number": 261,
      "shortId": "Z3N9M",
      "priority": 1,
      "shortName": "topbar-menu-1",
      "title": "topbar-menu-1: scope top-bar menubar + reuse contract (STUB)",
      "status": "planned",
      "description": "STUB task. When this becomes active: scope the top-bar menubar (File/Edit/View-style or heca-specific), activation key, region (TopBar). Reuse shared infra — do NOT fork: open_dropdown/DropdownSpec, entries-as-intents, menu-nav keys, ActionCatalog icon/label/tooltip, Contribution::Menu (sibling of Contribution::ContextMenu). Not scoped yet.",
