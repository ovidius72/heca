          "number": 2,
          "title": "Route through KeymapRegistry, never hardcoded",
          "checked": false
        },
        {
          "id": "read-default-binding-c3",
          "number": 3,
          "title": "Test: a registered action's default key fires it",
          "checked": false
        }
      ],
