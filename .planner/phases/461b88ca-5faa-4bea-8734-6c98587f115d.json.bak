          "checked": false
        },
        {
          "id": "a838cc76-edf3-4cb6-8126-d2e5ce52217c-check-005-capture-vs-bubble-decided-per-widget-gestures-swallows-capture-leftovers-bubble",
          "title": "capture vs bubble decided per widget: gestures/swallows capture, leftovers bubble",
