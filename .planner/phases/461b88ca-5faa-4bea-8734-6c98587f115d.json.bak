          "checked": false
        },
        {
          "id": "a838cc76-edf3-4cb6-8126-d2e5ce52217c-check-007-user-drives-focus-dropdowns-menus-palette-drag-sidebar-pane-headers-in-the-app",
          "title": "USER drives focus, dropdowns, menus, palette, drag, sidebar, pane headers in the app",
          "checked": false
        }
      ],
      "subtasks": [],
      "dependsOn": [],
      "startedAt": "2026-07-26T16:51:07.084Z",
      "completedAt": "2026-07-26T17:54:49.160Z",
