    {
      "id": "fe6f4b88-4cd7-4c0b-8f04-53c1bc03937e",
      "phaseId": "5464ff74-fa17-4412-abaa-95aa19810b33",
      "number": 339,
      "shortId": "PQADT",
      "priority": 1,
      "shortName": "layer-content-viewnode",
      "title": "Add LayerContent with the View(ViewNode) arm",
      "status": "planned",
      "description": "`heca/src/chrome/layers.rs` has `LayerBand` and `LayerKind` but no `LayerContent` — a layer holds a native tree and nothing can hand it a description. Add `LayerContent::{Native(Box<dyn Component>), View(ViewNode)}` and realize the View arm through the ONE bridge (heca/src/chrome/realize.rs). Occluder comes from the realized tree's laid-out bounds — NEVER hardcoded.",
