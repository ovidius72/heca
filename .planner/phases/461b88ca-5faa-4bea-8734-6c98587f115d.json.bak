          "id": "a838cc76-edf3-4cb6-8126-d2e5ce52217c-check-001-dispatch-is-the-only-child-walk-in-the-crate",
          "title": "dispatch() is the only child walk in the crate",
          "checked": false
        },
        {
          "id": "a838cc76-edf3-4cb6-8126-d2e5ce52217c-check-002-routes-own-subtree-declared-on-select-and-dialog-with-a-stated-reason-code-otherwise-untouched",
          "title": "routes_own_subtree() declared on Select and Dialog with a stated reason, code otherwise untouched",
          "checked": false
        },
        {
          "id": "a838cc76-edf3-4cb6-8126-d2e5ce52217c-check-003-all-24-widgets-migrated-no-route-event-call-left-in-a-widget",
          "title": "all 24 widgets migrated; no route_event call left in a widget",
          "checked": false
        },
        {
          "id": "a838cc76-edf3-4cb6-8126-d2e5ce52217c-check-004-every-event-call-site-across-the-workspace-moved-to-dispatch",
