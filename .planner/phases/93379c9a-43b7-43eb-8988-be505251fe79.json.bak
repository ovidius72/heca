    {
      "id": "d976a997-ed47-4b76-819d-2028cefa9eed",
      "phaseId": "93379c9a-43b7-43eb-8988-be505251fe79",
      "number": 201,
      "shortId": "L3GQ7",
      "priority": 7,
      "shortName": "next-expiry",
      "title": "Compute next visible notification expiry",
      "status": "planned",
      "description": "Implementare `next_expiry()` come minimo degli `expires_at` delle sole notifiche visibili auto-dismiss. Restituire `None` con sole pending/sticky o store vuoto. Dopo push, dedup, dismiss, expiry e promozione il risultato deve riflettere immediatamente il nuovo stato. Non chiamare `Instant::now` internamente.",
      "notes": "",
      "statusLog": [],
      "decisions": [],
      "acceptedDecisions": [],
      "checklist": [
        {
          "id": "d976a997-ed47-4b76-819d-2028cefa9eed-check-001-minimo-tra-visibili",
          "number": 1,
          "title": "Minimo tra visibili.",
          "checked": false
