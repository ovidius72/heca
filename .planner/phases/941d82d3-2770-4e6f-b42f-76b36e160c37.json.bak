{
  "id": "941d82d3-2770-4e6f-b42f-76b36e160c37",
  "featureId": "fc19894f-c2aa-4ed1-81f3-24d82670dbae",
  "number": 63,
  "shortId": "K928J",
  "priority": 8,
  "slug": "notification-08-native-os-notification-backend-post-v1",
  "title": "notification-08: Native OS Notification Backend (post-v1)",
  "discussedAt": "",
  "contextReady": false,
  "contextReadyReason": "",
  "summary": "Backend desktop nativo successivo alla stabilizzazione del percorso in-app.",
  "description": "Fase post-v1 esplicitamente differita. Dopo che overlay, router e producer reload sono stabili, definire un `SystemNotificationBackend` isolato dal modello UI e valutare `notify-rust` o API equivalenti su Linux, macOS e Windows. Il router `System` passa dal fallback in-app al backend nativo; se l'invio fallisce a runtime, logga l'errore e ricade in-app in modo deterministico senza perdere la notifica. Definire capability e limiti per azioni native: non promettere azioni se la piattaforma/libreria non può restituirle in modo portabile. Nessun codice OS entra in heca-grid-ui.",
  "notes": "",
  "goals": [
    "Contratto backend testabile tramite fake.",
    "Spikes piattaforma documentati prima di scegliere la dipendenza.",
    "Fallback runtime affidabile.",
    "Nessuna regressione del canale app."
  ],
  "nonGoals": [
    "Bloccare la prima versione in-app.",
    "Notifiche agent.",
    "Sincronizzazione cronologia con Notification Center OS."
  ],
  "dependencies": [
    "P057(F009) prima versione verificata e stabile."
  ],
  "dependsOn": [],
  "risks": [
    "Supporto azioni/callback differente tra piattaforme.",
    "Permessi e sandboxing macOS/Windows.",
    "Dipendenza multipiattaforma non uniforme: mantenere trait e fallback."
  ],
  "openQuestions": [],
  "decisions": [
    "Non implementare prima della stabilizzazione in-app.",
    "Errore backend OS ricade in-app e resta nei log."
  ],
  "acceptedDecisions": [],
  "completionCriteria": [
    "Trait e fake testati.",
    "Scelta libreria/API motivata per ogni piattaforma.",
    "System consegna nativamente quando disponibile e ricade in-app su errore.",
    "Documentazione aggiornata senza promesse non supportate."
  ],
