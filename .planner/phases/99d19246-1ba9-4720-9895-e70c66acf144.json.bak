      "checklist": [
        {
          "id": "c0e2d0de-3e8c-49da-bdd8-529d530a1cf2-check-001-add-scrollaxes-horizontal-both-builders-default-vertical-back-compat",
          "title": "Add ScrollAxes + .horizontal()/.both() builders (default Vertical, back-compat)",
          "checked": false
