      "priority": 2,
      "shortName": "realize-per-mode",
      "title": "Mode-awareness lives in exactly one place: realize()",
      "status": "planned",
      "description": "The host renders the one tree for the region's current mode. Expanded → Group becomes a `DockFrame`, Item becomes a `Row` with all extras. Collapsed → a `RailCell` per node, recursively, with expanded-only extras omitted. This must NOT be duplicated across widgets or in the author's code.",
      "notes": "",
      "statusLog": [],
      "decisions": [],
      "acceptedDecisions": [],
      "checklist": [
        {
          "id": "realize-per-mode-c1",
          "title": "Both renderings come from one tree",
          "checked": false
        },
        {
          "id": "realize-per-mode-c2",
          "title": "Mode branch exists only in realize()",
          "checked": false
        },
        {
          "id": "realize-per-mode-c3",
          "title": "Group collapse is a generic host behaviour, not workspace-specific",
          "checked": false
        }
