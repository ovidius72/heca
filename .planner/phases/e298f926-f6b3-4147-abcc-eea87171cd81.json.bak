      "shortId": "WAZD5",
      "priority": 1,
      "shortName": "decide-override-rule",
      "title": "DECIDE FIRST: does an explicit .border(color, width) override the global?",
      "status": "planned",
      "description": "⛔ Blocking, and it is the user's call. Either an explicit `.border(color, width)` still overrides the global width, or width is ALWAYS theme-driven and a widget picks only the colour. Both are defensible and the answer changes the widget API. Ties into the planned config (memory `border-style-config-options`: sidebar_border_style / pane_border_style).",
      "notes": "",
      "statusLog": [],
      "decisions": [],
      "acceptedDecisions": [],
      "checklist": [
        {
          "id": "decide-override-rule-c1",
          "title": "BLOCKING: put both options to the user with the trade-off",
          "checked": false
        }
      ],
