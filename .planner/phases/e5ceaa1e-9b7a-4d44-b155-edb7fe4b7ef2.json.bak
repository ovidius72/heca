      "shortId": "KTPUY",
      "priority": 2,
      "shortName": "confirm-dialog-as-layer",
      "title": "Convert the confirm dialog to a layer with hintable buttons",
      "status": "planned",
      "description": "Migration step 2 from the design. A modal that draws its buttons manually has no child subtree, so `collect_hint_targets` finds nothing and it shows no keycaps — against the project rule that every action is KeyHint-reachable. Do it the conformant way: `OverlayHost::open_modal` with a ViewNode body and actions, NOT a bespoke modal.",
      "notes": "",
      "statusLog": [],
      "decisions": [],
      "acceptedDecisions": [],
      "checklist": [
        {
          "id": "confirm-dialog-as-layer-c1",
          "title": "Confirm dialog goes through OverlayHost::open_modal",
          "checked": false
        },
        {
          "id": "confirm-dialog-as-layer-c2",
          "title": "Its buttons are real components with hint targets",
          "checked": false
        },
        {
          "id": "confirm-dialog-as-layer-c3",
          "title": "USER confirms the keycaps appear",
          "checked": false
        }
      ],
