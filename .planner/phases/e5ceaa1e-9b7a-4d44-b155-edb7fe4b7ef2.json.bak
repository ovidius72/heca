      "number": 319,
      "shortId": "YQLV7",
      "priority": 1,
      "shortName": "provider-content-model",
      "title": "The write-once Group/Item content model",
      "status": "planned",
      "description": "A Provider describes its content ONCE as a semantic tree of Groups and Items. Each node carries its meaning a single time: an Item has icon, label, status, intent and expanded-only actions; a Group has identity, collapsed, and children nested to any depth. The author NEVER writes an expanded tree and a collapsed tree — that double authoring is what this rejects, and it would fall on every plugin too.",
      "notes": "",
      "statusLog": [],
      "decisions": [],
      "acceptedDecisions": [],
      "checklist": [
        {
          "id": "provider-content-model-c1",
          "title": "Group/Item model defined",
          "checked": false
        },
        {
          "id": "provider-content-model-c2",
          "title": "Nesting to any depth",
          "checked": false
        },
        {
          "id": "provider-content-model-c3",
          "title": "No second tree anywhere in the author's code",
          "checked": false
        }
      ],
      "subtasks": [],
      "dependsOn": [],
      "startedAt": "",
      "completedAt": "",
      "createdAt": "2026-07-26T11:44:50.918444Z",
      "updatedAt": "2026-07-26T11:44:50.918444Z"
    },
