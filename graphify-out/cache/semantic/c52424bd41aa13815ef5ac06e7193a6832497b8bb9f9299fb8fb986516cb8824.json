{"nodes": [{"id": "docs_niri_wiki_04development_design_principles_md", "label": "NIRI Design Principles Documentation", "file_type": "document", "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "niri_scrollable_tiling", "label": "NIRI Scrollable Tiling Layout Model", "file_type": "concept", "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "niri_design_principles", "label": "NIRI's 5 Core Design Principles", "file_type": "rationale", "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The five principles ensure predictable layout behavior: windows don't resize each other, focused windows stay stable, actions are immediate, disabled features have zero perf cost, and eye candy doesn't cause excessive rendering. These principles are the foundation of the scrollable tiling model."}, {"id": "niri_no_window_reflow", "label": "Opening a New Window Does Not Affect Sizes of Existing Windows", "file_type": "rationale", "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike BSP tiling where splits resize neighbors, scrollable tiling places new columns/panes alongside existing ones without reflow. This gives predictable layout behavior."}, {"id": "niri_focused_window_stability", "label": "Focused Window Does Not Move on Its Own", "file_type": "rationale", "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows opening/closing/resizing left of the focused window should not visually move it. The view offset preserves the focused column's position."}, {"id": "niri_immediate_actions", "label": "Actions Should Apply Immediately", "file_type": "rationale", "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Input goes to the final target even during animations. State transitions are instant even if the visual catch-up animates. Prevents race conditions between input and layout state."}], "edges": [{"source": "docs_niri_wiki_04development_design_principles_md", "target": "niri_design_principles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}, {"source": "docs_niri_wiki_04development_design_principles_md", "target": "niri_no_window_reflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}, {"source": "docs_niri_wiki_04development_design_principles_md", "target": "niri_focused_window_stability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}, {"source": "docs_niri_wiki_04development_design_principles_md", "target": "niri_immediate_actions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}, {"source": "docs_niri_wiki_04development_design_principles_md", "target": "niri_scrollable_tiling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}, {"source": "niri_no_window_reflow", "target": "niri_scrollable_tiling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}, {"source": "niri_focused_window_stability", "target": "niri_scrollable_tiling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}, {"source": "niri_immediate_actions", "target": "niri_design_principles", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}, {"source": "niri_no_window_reflow", "target": "niri_focused_window_stability", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/niri-wiki/04-development/design-principles.md", "source_location": null, "weight": 1.0}], "hyperedges": []}